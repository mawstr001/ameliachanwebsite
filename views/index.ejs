<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%- include('partials/seo', {
  seoTitle: 'Amelia Chan — Violinist · First Principles Violin',
  seoDesc:  'Amelia Chan is a violinist, concertmaster, and educator — creator of the First Principles Violin system, combining biomechanics, acoustics, and cognition.',
  seoPath:  '/',
  seoJsonLd: {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'WebSite',
        '@id': (siteUrl || 'https://ameliachanviolin.com') + '/#website',
        url: siteUrl || 'https://ameliachanviolin.com',
        name: 'Amelia Chan — First Principles Violin',
        description: 'Violinist, concertmaster, and educator Amelia Chan shares her biomechanics-based approach to violin technique.'
      },
      {
        '@type': 'Person',
        '@id': (siteUrl || 'https://ameliachanviolin.com') + '/#person',
        name: 'Amelia Chan',
        url: siteUrl || 'https://ameliachanviolin.com',
        jobTitle: 'Violinist & Educator',
        description: 'Concertmaster and creator of the First Principles Violin system.',
        sameAs: [site.instagram, site.facebook]
      }
    ]
  }
}) %>
<link rel="stylesheet" href="/styles.css" />
<% if (isAdmin) { %><link rel="stylesheet" href="/admin-bar.css" /><% } %>
</head>
<body data-screen-label="Home"<% if (isAdmin) { %> data-admin-mode<% } %>>

<%- include('partials/nav', { site, page }) %>

<main>

<!-- ============================ HERO ============================ -->
<section class="wrap hero">
  <div>
    <div class="label" style="font-size:16px" data-edit="home.left.kicker"><%= home.left.kicker %></div>
    <h1 class="hero-name">Amelia Chan</h1>
    <p class="hero-role" style="font-size:23px;font-weight:600" data-edit="home.left.role"><%= home.left.role %></p>
    <p class="hero-lead" data-edit="home.left.blurb"><%= home.left.blurb %></p>
    <a class="btn hero-cta" href="/bio">Read Biography</a>
  </div>
  <div class="photo-wrap">
    <div class="figure portrait">
      <image-slot id="hero-portrait" placeholder="Drop portrait — violinist"
        src="<%= home.left.heroImage %>" data-edit-image="home.left.heroImage"></image-slot>
    </div>
    <% if (home.left.photoCredit) { %><p class="photo-credit" data-edit="home.left.photoCredit"><%= home.left.photoCredit %></p><% } %>
  </div>
</section>

</main>

<%- include('partials/footer', { site }) %>

<script src="/image-slot.js"></script>
<script src="/site.js"></script>
<% if (isAdmin) { %><script src="/admin-bar.js"></script><% } %>
</body>
</html>
