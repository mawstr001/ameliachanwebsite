<%
  // Social icons (Tabler icon paths, 24×24, stroke). An icon only shows once
  // its link is filled in under Admin → Site Settings.
  var socials = [
    { url: site.instagram, label: 'Instagram', paths: ['M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z', 'M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0', 'M16.5 7.5v.01'] },
    { url: site.facebook, label: 'Facebook', paths: ['M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3'] },
    { url: site.youtube, label: 'YouTube', paths: ['M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8z', 'M10 9l5 3l-5 3z'] },
    { url: site.threads, label: 'Threads', paths: ['M19 7.5c-1.333 -3 -3.667 -4.5 -7 -4.5c-5 0 -8 2.5 -8 9s3.5 9 8 9s7 -3 7 -5s-1 -5 -7 -5c-2.5 0 -3 1.25 -3 2.5c0 1.5 1 2.5 2.5 2.5c2.5 0 3.5 -1.5 3.5 -5s-2 -4 -3 -4s-1.833 .333 -2.5 1'] },
    { url: site.x, label: 'X', paths: ['M4 4l11.733 16h4.267l-11.733 -16z', 'M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772'] },
    { url: site.email ? 'mailto:' + site.email : '', label: 'Email', paths: ['M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z', 'M3 7l9 6l9 -6'] }
  ].filter(function (s) { return s.url; });
%>
<footer class="footer" id="contact">
  <div class="foot-inner">
    <div class="foot-social">
      <% socials.forEach(function (s) { %>
      <a href="<%= s.url %>" aria-label="<%= s.label %>" title="<%= s.label %>"<% if (s.label !== 'Email') { %> target="_blank" rel="noopener"<% } %>>
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><% s.paths.forEach(function (d) { %><path d="<%= d %>"/><% }); %></svg>
      </a>
      <% }); %>
    </div>
    <div class="foot-fine">
      <span><%= site.copyright %></span>
    </div>
  </div>
  <div class="barstrip cap"><i class="ox"></i><i class="gd"></i><i class="nv"></i></div>
</footer>
