<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%- include('partials/seo', {
  seoTitle: 'The First Principles Violin System — Amelia Chan',
  seoDesc:  'A biomechanics-based approach to violin technique: optimise movement, master acoustics, and develop the mental cognition for expressive, injury-free playing.',
  seoPath:  '/first-principles',
  seoJsonLd: {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: 'The First Principles Violin System',
    description: 'A biomechanics-based approach to violin technique combining Biomechanics in Action, Fundamental Acoustics, and Mental Cognition.',
    provider: { '@type': 'Person', name: 'Amelia Chan', url: siteUrl || 'https://ameliachanviolin.com' },
    url: (siteUrl || 'https://ameliachanviolin.com') + '/first-principles'
  }
}) %>
<link rel="stylesheet" href="/styles.css" />
<% if (isAdmin) { %><link rel="stylesheet" href="/admin-bar.css" /><% } %>
</head>
<body data-screen-label="First Principles"<% if (isAdmin) { %> data-admin-mode<% } %>>

<%- include('partials/nav', { site, page }) %>

<main>

<!-- ============================ THE METHOD ============================ -->
<!-- Same layout as the Home hero: text and button on the left, image on the right -->
<section class="wrap hero">
  <div>
    <div class="label" style="font-size:16px" data-edit="firstPrinciples.sectionNum"><%= fp.sectionNum %></div>
    <h1 class="hero-name fp-title" data-edit="firstPrinciples.heading"><%= fp.heading %></h1>
    <ol class="principles fp-principles">
      <li>
        <span class="n">1</span>
        <div>
          <h3 data-edit="firstPrinciples.method1Label"><%= fp.method1Label %></h3>
          <p data-edit="firstPrinciples.method1Desc"><%= fp.method1Desc %></p>
        </div>
      </li>
      <li>
        <span class="n">2</span>
        <div>
          <h3 data-edit="firstPrinciples.method2Label"><%= fp.method2Label %></h3>
          <p data-edit="firstPrinciples.method2Desc"><%= fp.method2Desc %></p>
        </div>
      </li>
      <li>
        <span class="n">3</span>
        <div>
          <h3 data-edit="firstPrinciples.method3Label"><%= fp.method3Label %></h3>
          <p data-edit="firstPrinciples.method3Desc"><%= fp.method3Desc %></p>
        </div>
      </li>
    </ol>
    <a class="btn hero-cta" href="/writings"><span data-edit="firstPrinciples.ctaLabel"><%= fp.ctaLabel %></span></a>
  </div>
  <div class="photo-wrap">
    <div class="fp-mark" data-edit-image="firstPrinciples.logoImage">
      <% if (fp.logoImage) { %>
      <img src="<%= fp.logoImage %>" alt="<%= fp.logoAlt %>" />
      <% } else { %>
      <div class="colorblocks" aria-hidden="true">
        <div class="cb-ox"></div>
        <div class="cb-gd"></div>
        <div class="cb-nv"></div>
      </div>
      <% } %>
    </div>
  </div>
</section>

</main>

<%- include('partials/footer', { site }) %>

<script src="/image-slot.js"></script>
<script src="/site.js"></script>
<% if (isAdmin) { %><script src="/admin-bar.js"></script><% } %>
</body>
</html>
